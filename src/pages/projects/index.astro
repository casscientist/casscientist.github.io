---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const allWork = (await getCollection('work', ({ data }) => !data.draft));
const sorted = [...allWork].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
// Split the data
const featured = sorted.filter(p => p.data.featured);
const personal = sorted.filter(p => !p.data.featured);
---

<BaseLayout
  title="Projects"
  description="Selected projects"
>
  <section class="mx-auto max-w-5xl px-6 py-16">
  <!-- Featured Section: 2 Columns -->
  <h2 class="font-mono text-2xl mb-8">Featured Work</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-20">
    {featured.map((entry) => <WorkRow entry={entry} />)}
  </div>

  <!-- Personal Section: 3 Columns -->
  <h2 class="font-mono text-2xl mb-8">Older Projects</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {personal.map((entry) => <WorkRow entry={entry} />)}
  </div>
</section>
</BaseLayout>
